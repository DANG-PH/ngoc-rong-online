google.client.id=YOUR_CLIENT_ID
google.client.secret=YOUR_CLIENT_SECRET
// Android đăng nhập Google qua Credential Manager (không qua redirect như Desktop) — cần thêm:
// 1. 1 OAuth Client ID loại "Android" trên Google Cloud Console (package name + SHA-1 keystore),
//    không có secret. Không cần điền ID này vào đây, chỉ cần nó TỒN TẠI trên Cloud Console để
//    Google Play Services xác thực app.
// 2. 1 OAuth Client ID loại "Web application" — điền vào key dưới đây. Đây là ID thật sự được
//    dùng trong code (AndroidGoogleOAuth.java), theo đúng quy định của Google Identity Services.
google.client.id.web=YOUR_WEB_CLIENT_ID
// Nếu k có thì dùng server này
api.base.url=https://api.dangpham.id.vn
ws.nestjs.url=https://ws.dangpham.id.vn/ws-game
ws.go.url=wss://ws-go.dangpham.id.vn/ws-game
